{
	"schemaVersion": 1,
	"id": "helper",
	"version": "${version}",
	"name": "Helper",
	"description": "A lightweight, pure client-side recipe viewer and item browser.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/helper/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.example.client.HelperClient"
		]
	},
	"mixins": [
		{
			"config": "helper.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}